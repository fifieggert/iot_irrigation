# =========================================================================
# Banco de dados (Supabase / PostgreSQL via Connection Pooler - Supavisor)
# A conexao direta (db.<ref>.supabase.co) so tem IPv6; use o pooler.
# =========================================================================
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=sua-senha-do-banco
POSTGRES_HOST=aws-0-us-east-2.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_SSLMODE=require

# (Opcionais, caso o frontend use o SDK do Supabase diretamente)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# =========================================================================
# MQTT (HiveMQ)
# Porta 1883 = sem TLS (broker publico). Porta 8883 = TLS (habilita automatico).
# =========================================================================
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_BASE=g2fifi/irrigation/v1
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# =========================================================================
# Autenticacao / JWT (R9)
# Gere um segredo forte, por ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# =========================================================================
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# =========================================================================
# Notificacao por e-mail / SMTP (R15) - opcional
# Sem SMTP_HOST/ALERT_EMAIL_TO, os alertas apenas sao logados.
# =========================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
ALERT_EMAIL_TO=

# =========================================================================
# Regras de negocio (defaults; podem ser alterados em /api/v1/config)
# =========================================================================
LIMITE_UMIDADE_MIN=30
LIMITE_UMIDADE_MAX=60
DIAS_SEM_SOL_ALERTA=3
LIMIAR_LUMINOSIDADE=20
SUNLIGHT_CHECK_INTERVAL=3600
