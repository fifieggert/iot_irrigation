{
  "version": 1,
  "author": "Grupo 2 - Irrigacao de vaso",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": -70,
      "left": 280,
      "attrs": { "value": "2048" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 130,
      "left": 270,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 100,
      "left": 400,
      "attrs": { "color": "blue", "label": "Bomba" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "pot1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "pot1:SIG", "esp:D34", "green", [ "v0" ] ],

    [ "esp:D23", "r1:1", "blue", [ "v0" ] ],
    [ "r1:2", "led1:A", "blue", [ "v0" ] ],
    [ "led1:C", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
